{
  "expo": {
    "name": "plant-live",
    "slug": "plant-live",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "plantlive",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/leaflink-icons/ios/AppIcon-1024.png",
      "bundleIdentifier": "com.rudresh.leaflink",
      "infoPlist": {
        "NSCameraUsageDescription": "LeafLink uses the camera to scan your controller’s pairing QR code.",
        "NSLocationWhenInUseUsageDescription": "LeafLink uses your location to provide local Open-Meteo forecasts.",
        "NSLocalNetworkUsageDescription": "LeafLink connects to your controller’s local Wi-Fi hotspot during pairing.",
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true,
          "NSExceptionDomains": {
            "192.168.4.1": {
              "NSExceptionAllowsInsecureHTTPLoads": true
            }
          }
        }
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#16221A",
        "foregroundImage": "./assets/leaflink-icons/android/res/mipmap-xxxhdpi/ic_launcher_foreground.png",
        "backgroundImage": "./assets/leaflink-icons/android/res/mipmap-xxxhdpi/ic_launcher_background.png",
        "monochromeImage": "./assets/leaflink-icons/android/res/mipmap-xxxhdpi/ic_launcher_monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.rudresh.leaflink"
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#16221A",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 180
        }
      ],
      "expo-font",
      "expo-image",
      "expo-status-bar",
      "expo-web-browser",
      "expo-asset",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow LeafLink to use your location for accurate outdoor weather."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow LeafLink to access your photos to set your profile avatar."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      [
        "expo-notifications",
        {
          "defaultChannel": "default"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
